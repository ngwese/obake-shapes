Bootstrap: docker
From: debian:trixie
Stage: build

%environment
	export LC_ALL=C

%post
	export PIN_CHUCK={{ chuck_version }}

	export DEBIAN_FRONTEND=noninteractive
	export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig

	# freshen bits
	apt-get update && apt-get upgrade -y

	# chuck build dependencies (JACK headers only; no jackd2 server)
	apt-get install -y \
		wget \
		build-essential \
		bison \
		flex \
		libsndfile1-dev \
		libasound2-dev \
		libjack-jackd2-dev


	# chuck build
	wget https://chuck.stanford.edu/release/files/chuck-${PIN_CHUCK}.tgz
	tar zxvf chuck-${PIN_CHUCK}.tgz
	cd chuck-${PIN_CHUCK}/src/
	make linux-jack
	make install
	rm -rf chuck-${PIN_CHUCK}

Bootstrap: docker
From: debian:trixie-slim
Stage: final

%files from build
	/usr/local/* /usr/local/

%post
	apt-get update
	apt-get install -y -q \
		libsndfile1 \
		libasound2t64 \
		pipewire-jack
	rm -rf /var/lib/apt/lists/*


%runscript
	pw-jack /usr/local/bin/chuck $*

%labels
	com.afofo.obake.shape-schema 0.1
	com.afofo.obake.shape-name chuck
	com.afofo.obake.shape-app-version {{ chuck_version }}
