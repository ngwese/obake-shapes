Bootstrap: docker
From: alpine:edge
Stage: build

%environment
	export LC_ALL=C

%post
	export PIN_CHUCK={{ chuck_version }}

	# build deps (JACK headers from pipewire-jack-dev; no jackd server)
	apk add --no-cache \
		build-base \
		linux-headers \
		bison \
		flex \
		wget \
		libsndfile-dev \
		alsa-lib-dev \
		pipewire-jack-dev

	# chuck build
	wget https://chuck.stanford.edu/release/files/chuck-${PIN_CHUCK}.tgz
	tar zxvf chuck-${PIN_CHUCK}.tgz
	cd chuck-${PIN_CHUCK}/src/
	make linux-jack
	make install
	rm -rf chuck-${PIN_CHUCK}

Bootstrap: docker
From: alpine:edge
Stage: final

%files from build
	/usr/local/* /usr/local/

%post
	apk add --no-cache \
		libsndfile \
		alsa-lib \
		pipewire-jack

%runscript
	pw-jack /usr/local/bin/chuck $*

%labels
	com.afofo.obake.shape-schema 0.1
	com.afofo.obake.shape-name chuck-alpine
	com.afofo.obake.shape-app-version {{ chuck_version }}
